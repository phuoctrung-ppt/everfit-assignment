# Copy to .env and replace the password. URL-encode special characters in URLs.
POSTGRES_USER=everfit
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=everfit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://everfit:replace-with-local-password@localhost:5432/everfit
# Dedicated local test server only; role must have CREATEDB. Never use a production server.
TEST_DATABASE_ADMIN_URL=postgresql://everfit:replace-with-local-password@localhost:5432/postgres
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=3000
