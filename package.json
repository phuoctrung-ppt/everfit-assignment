{
  "name": "everfit-workout-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node --env-file-if-exists=.env node_modules/@nestjs/cli/bin/nest.js start --watch",
    "lint": "eslint src test scripts migrations *.ts *.mjs && prettier --check src test scripts migrations *.json *.ts *.mjs compose.yaml README.md",
    "format": "prettier --write src test scripts migrations *.json *.ts *.mjs compose.yaml README.md",
    "test": "pnpm test:unit --runInBand && pnpm test:integration --runInBand",
    "test:unit": "jest --config jest.config.ts",
    "test:performance": "pnpm build && node --env-file-if-exists=.env -r ts-node/register scripts/benchmark-workouts.ts",
    "test:performance:bulk": "pnpm build && node --env-file-if-exists=.env -r ts-node/register test/performance/run-bulk-performance.ts",
    "test:performance:batch-retry": "pnpm build && node --env-file-if-exists=.env -r ts-node/register test/performance/run-batch-retry.ts",
    "test:integration": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config test/jest-integration.config.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.cjs up",
    "db:rollback": "node --env-file-if-exists=.env scripts/migrate.cjs down",
    "db:seed": "node --env-file-if-exists=.env -r ts-node/register scripts/seed-exercises.ts",
    "smoke": "node -r ts-node/register scripts/smoke-api.ts",
    "start:import-worker": "node --env-file-if-exists=.env dist/import-worker.js",
    "test:performance:csv": "pnpm build && node --env-file-if-exists=.env -r ts-node/register test/performance/run-csv-import.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
